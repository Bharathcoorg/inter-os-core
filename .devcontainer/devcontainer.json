{
  "name": "InterOS Cloud Studio & Development Environment",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y qemu-system-x86 qemu-system-arm websockify && rustup target add aarch64-unknown-none x86_64-unknown-none && pip install websockify",
  "postStartCommand": "python emulator/server.py &",
  "forwardPorts": [4200, 4201, 4202],
  "portsAttributes": {
    "4200": {
      "label": "Inter OS Live Smartphone Studio",
      "onAutoForward": "openBrowser"
    },
    "4201": {
      "label": "UART Serial Telemetry Bridge",
      "onAutoForward": "silent"
    },
    "4202": {
      "label": "QEMU Machine Protocol (QMP)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.cargo.allTargets": false,
        "rust-analyzer.check.allTargets": false,
        "rust-analyzer.cargo.target": "aarch64-unknown-none",
        "rust-analyzer.cargo.extraArgs": ["--target", "aarch64-unknown-none"],
        "rust-analyzer.check.extraArgs": ["--target", "aarch64-unknown-none"],
        "editor.formatOnSave": true
      }
    }
  }
}
