{
  "id": "org.interos.meshchat",
  "name": "Mesh Chat",
  "version": "1.0.0",
  "category": "communication",
  "description": "Ring 3 peer-to-peer messenger that reports real transport state and exercises the real local datagram path",
  "icon": "ui/icon.svg",
  "entrypoint": {
    "backend": "bin/meshchat.elf"
  },
  "permissions": [
    "CAP_LOGGING",
    "CAP_EVENT_POLL",
    "CAP_IPC_RECEIVE",
    "CAP_NETWORK_SOCKET",
    "CAP_NETWORK_SEND",
    "CAP_NETWORK_RECEIVE"
  ],
  "min_sdk_version": "0.8.0"
}
