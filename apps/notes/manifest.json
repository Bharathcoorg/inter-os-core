{
  "id": "org.interos.notes",
  "name": "Notes",
  "version": "1.0.0",
  "category": "personal",
  "description": "Sovereign native notepad with persistent local storage and clock-derived timestamps.",
  "icon": "NOTE",
  "entrypoint": {
    "backend": "bin/notes.elf"
  },
  "permissions": [
    "CAP_LOGGING",
    "CAP_FRAMEBUFFER",
    "CAP_EVENT_POLL",
    "CAP_FILESYSTEM_READ",
    "CAP_FILESYSTEM_WRITE",
    "CAP_REALTIME_CLOCK",
    "CAP_CONTENT_INDEX"
  ],
  "intents": {
    "mime": [
      "text/x-interos-note"
    ]
  },
  "min_sdk_version": "0.8.0"
}
