{
  "id": "org.interos.terminal",
  "name": "Terminal",
  "version": "1.0.0",
  "category": "system",
  "description": "Native terminal for the text documents the device holds.",
  "icon": "TERM",
  "entrypoint": {
    "backend": "bin/terminal.elf"
  },
  "permissions": [
    "CAP_LOGGING",
    "CAP_FRAMEBUFFER",
    "CAP_EVENT_POLL",
    "CAP_FILESYSTEM_READ",
    "CAP_CONTENT_INDEX"
  ],
  "intents": {
    "mime": [
      "text/plain",
      "text/markdown",
      "text/csv",
      "application/json"
    ]
  },
  "min_sdk_version": "0.8.0"
}
