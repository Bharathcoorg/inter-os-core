  "endpoints": {
    "serial": "127.0.0.1:4301",
    "hmp": "127.0.0.1:44445",
    "vnc": "127.0.0.1:5901",
    "websocket": "127.0.0.1:6081"
  },
  "verification": "qemu-development-only"
}
