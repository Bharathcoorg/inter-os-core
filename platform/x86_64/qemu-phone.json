{
  "schema_version": 1,
  "profile": "qemu-phone",
  "architecture": "x86_64",
  "machine": "q35",
  "cpu": "qemu64",
  "memory_mb": 1024,
  "display": {
    "width": 1280,
    "height": 720,
    "pixel_format": "ARGB8888",
    "backend": "vga-vnc"
