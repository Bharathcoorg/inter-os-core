{
  "id": "org.interos.sampleweb",
  "name": "Sample Web App",
  "version": "1.0.0",
  "description": "Minimalist sample web app demonstrating HTML, CSS & JavaScript for Inter OS",
  "author": "InterOS Community Developer",
  "entry": "index.html",
  "icon": "📝",
  "permissions": [
    "vfs.read",
